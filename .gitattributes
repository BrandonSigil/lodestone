* text=auto eol=lf
*.png filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
# Generated art templates and diagrams stay in plain git (small, and rebuilt by tools/art/battle_art.py).
art/templates/** -filter -diff -merge binary
docs/art/** -filter -diff -merge binary
docs/art/*.md text eol=lf
# Picsart battle kit finals stay in plain git (the cloud machine cannot fetch LFS).
game/art/source/battle/** -filter -diff -merge binary
docs/art/battle-maps/** -filter -diff -merge binary
# Exported map paintings stay plain git so cloud sessions can read them (.kra working files stay LFS).
art/paintings/*.png -filter -diff -merge binary
# Character working exports and game sprites stay plain git so cloud sessions can export and read them (.kra stays LFS).
art/characters/**/*.psd -filter -diff -merge binary
art/characters/**/*.ora -filter -diff -merge binary
art/characters/**/*.png -filter -diff -merge binary
game/art/source/characters/** -filter -diff -merge binary
art/palettes/*.png -filter -diff -merge binary
